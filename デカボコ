-- ===== アンチ系 =====
rs.Heartbeat:Connect(function()
    local c=p.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    local root=gR(c)
    if h then
        if s.antiFreeze then
            if h:GetState()==Enum.HumanoidStateType.Frozen or h:GetState()==Enum.HumanoidStateType.PlatformStanding then
                h:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
        if s.antiRagdoll then
            if h:GetState()==Enum.HumanoidStateType.FallingDown or h:GetState()==Enum.HumanoidStateType.Ragdoll then
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        if h.PlatformStand then h.PlatformStand=false end
    end
    if s.antiFling and root then
        if root.Velocity.Magnitude>200 then
            root.Velocity=Vector3.new(0,0,0)
        end
    end
end)

-- ===== スピード・ジャンプ =====
rs.Heartbeat:Connect(function()
    local c=p.Character
    if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if h then
        if s.spd then h.WalkSpeed=spdVal else h.WalkSpeed=16 end
        if s.jmp then h.JumpPower=jumpVal else h.JumpPower=50 end
    end
    if s.noclip then
        for _,part in ipairs(c:GetDescendants())do
            if part:IsA("BasePart")then part.CanCollide=false end
        end
    end
end)

-- ===== ESP =====
local es={}
rs.RenderStepped:Connect(function()
    if not s.esp then
        for _,v in pairs(es)do if v then v.Visible=false end end
        return
    end
    local vw=cam.ViewportSize
    for _,pl in ipairs(game.Players:GetPlayers())do
        if pl~=p then
            local ch=pl.Character
            if ch and ch:FindFirstChild("Head")then
                local head=ch.Head
                local pos,on=cam:WorldToScreenPoint(head.Position)
                if on and pos.Z>0 then
                    if not es[pl]then
                        local txt=Drawing.new("Text")
                        txt.Size=14 txt.Center=true txt.Outline=true txt.OutlineColor=Color3.fromRGB(0,0,0) txt.Font=3
                        es[pl]=txt
                    end
                    local txt=es[pl]
                    txt.Text=pl.Name
                    txt.Position=Vector2.new(pos.X,pos.Y-30)
                    txt.Color=Color3.fromRGB(100,180,255)
                    txt.Visible=true
                else
                    if es[pl]then es[pl].Visible=false end
                end
            end
        end
    end
end)

-- ===== オートエイム =====
rs.RenderStepped:Connect(function()
    if not s.aim then return end
    local c=p.Character
    if not c then return end
    local r=gR(c)
    if not r then return end
    local t=nil
    local md=math.huge
    for _,pl in ipairs(game.Players:GetPlayers())do
        if pl~=p then
            local ch=pl.Character
            if ch then
                local rr=gR(ch)
                if rr then
                    local d=(r.Position-rr.Position).Magnitude
                    if d<md then md=d t=rr end
                end
            end
        end
    end
    if t then r.CFrame=CFrame.new(r.Position,t.Position) end
end)

